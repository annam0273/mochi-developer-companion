{
  "manifest_version": 3,
  "name": "Nick - The developer companion",
  "version": "1.0",
  "description": "A fully autonomous 2D SVG character companion for web developers.",
  "permissions": ["contextMenus", "storage", "unlimitedStorage", "offscreen", "activeTab"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "assets/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
